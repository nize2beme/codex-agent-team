prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Pushing changes should remain an explicit approval step.",
    match = ["git push", "git push origin main"],
    not_match = ["git status"],
)

prefix_rule(
    pattern = ["git", "push", ["--force", "--force-with-lease"]],
    decision = "forbidden",
    justification = "Do not rewrite remote history from Codex.",
    match = ["git push --force", "git push --force-with-lease origin main"],
    not_match = ["git push", "git push origin main"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Do not discard local changes from Codex.",
    match = ["git reset --hard", "git reset --hard HEAD"],
    not_match = ["git reset", "git status"],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "prompt",
    justification = "Cleaning untracked files can remove local work.",
    match = ["git clean -fd", "git clean -fdx"],
    not_match = ["git status"],
)

prefix_rule(
    pattern = ["gh", "pr", "create"],
    decision = "prompt",
    justification = "Creating a pull request is an external write.",
    match = ["gh pr create", "gh pr create --fill"],
)

prefix_rule(
    pattern = ["python3", "-m", "pip", "install"],
    decision = "prompt",
    justification = "Dependency installation should use project-local isolation.",
    match = ["python3 -m pip install requests", "python3 -m pip install -r requirements.txt"],
    not_match = ["python3 -m py_compile app.py", "python3 -m pytest"],
)

prefix_rule(
    pattern = ["terraform", "apply"],
    decision = "prompt",
    justification = "Applying infrastructure changes needs explicit review.",
    match = ["terraform apply", "terraform apply -auto-approve"],
)

prefix_rule(
    pattern = ["terraform", "destroy"],
    decision = "prompt",
    justification = "Destroying infrastructure needs explicit approval and an impact statement.",
    match = ["terraform destroy", "terraform destroy -auto-approve"],
)

prefix_rule(
    pattern = ["kubectl", "apply"],
    decision = "prompt",
    justification = "Applying cluster changes needs target confirmation and review.",
    match = ["kubectl apply -f deployment.yaml", "kubectl apply -f ./manifests"],
)

prefix_rule(
    pattern = ["kubectl", "delete"],
    decision = "prompt",
    justification = "Deleting cluster resources needs explicit approval.",
    match = ["kubectl delete pod example", "kubectl delete namespace example"],
)

prefix_rule(
    pattern = ["helm", "upgrade"],
    decision = "prompt",
    justification = "A release change can affect a shared service.",
    match = ["helm upgrade app ./chart", "helm upgrade --install app ./chart"],
)

prefix_rule(
    pattern = ["helm", "uninstall"],
    decision = "prompt",
    justification = "Uninstalling a release can remove running service resources.",
    match = ["helm uninstall app", "helm uninstall app --namespace production"],
)

prefix_rule(
    pattern = ["docker", "system", "prune"],
    decision = "prompt",
    justification = "Pruning removes local containers, images, networks, and caches.",
    match = ["docker system prune", "docker system prune --all"],
)
